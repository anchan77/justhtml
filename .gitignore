# =============================================================================
# justhtml C++ project .gitignore
# =============================================================================

# ----- C++ Build Artifacts -----
build/
build-*/
cmake-build-*/
out/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# ----- CMake -----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
_deps/
CMakeUserPresets.json
compile_commands.json

# ----- IDE / Editor -----
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.vs/
*.suo
*.user

# ----- OS -----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Environment / secrets (should never be committed) -----
.env
.env.*
!.env.example
!.env.template

# ----- Test / coverage -----
coverage/
*.lcov
*.gcno
*.gcda
*.gcov

# ----- Logs -----
*.log
Testing/
